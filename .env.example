# Kopiera till .env.local (utveckling) eller .env (server). Checka aldrig in riktiga värden.

# Lösenord till databasen i Docker (hitta på ett långt, t.ex. openssl rand -hex 24)
POSTGRES_PASSWORD=

# PostgreSQL-anslutning för appen (sätts automatiskt i docker-compose; behövs för lokal utveckling)
DATABASE_URL=postgres://app:app@localhost:5432/projektstod
# Bas-URL för testerna; varje testfil skapar och tar bort en egen databas här
TEST_DATABASE_URL=postgres://app:app@localhost:5432/projektstod

# Google Drive-mappen "Vagnharad projekt"
DRIVE_ROOT_FOLDER_ID=1lwRXzjFeMqyTWVt2iBrNuJHTtTvoovPJ

# AI-förslag ur mötesprotokoll. Lämna false tills sekretessfrågan är avgjord.
AI_ENABLED=false

# Inloggning (en användare). Skapa hashen med:
#   echo -n 'ditt-lösenord' | npx tsx scripts/hash-password.ts
APP_PASSWORD_HASH=
# Minst 32 slumpmässiga tecken, t.ex. från: openssl rand -hex 32
SESSION_SECRET=
# Sätt true endast om appen nås via http (utan https), t.ex. via Tailscale-adress
INSECURE_COOKIE=true

# Google service account. Enklast: lägg den nedladdade JSON-filen i secrets/google-service-account.json
# (docker-compose pekar GOOGLE_SERVICE_ACCOUNT_FILE dit). Alternativt hela JSON:en på en rad här.
# Dela Drive-mappen med service-kontots e-postadress (behörighet: Läsare).
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Nyckel för automatisk nattlig synk (scheduler-tjänsten). Minst 16 tecken: openssl rand -hex 24
SYNC_TOKEN=

# Endast för utveckling/test: DRIVE_CLIENT=fake läser påhittade filer från DRIVE_FAKE_DIR
# DRIVE_CLIENT=fake
# DRIVE_FAKE_DIR=tests/fixtures/out

# Endast om AI_ENABLED=true: nyckel till Anthropics API och (valfritt) modell
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
